#!/usr/bin/env bash
# tuna-greeter-proof: the Tuna login screen on GDM's greeter API in the
# nested session (#1164, docs/greeter.md, ledger P-LK-03).
#
# Usage:
#   scripts/tuna-greeter-proof [--display :N] [--artifacts DIR]
#
# Binaries: $TUNA_PROOF_BIN_DIR when set, else a cargo build of
# tuna-compositor and tuna-greeter (${CARGO_TARGET_DIR:-target}/debug).
#
# The real `tuna-compositor --greeter` runs nested on Xvfb and supervises
# the real tuna-greeter (TUNA_GREETER_TRACE=1) on a private session bus,
# AT-SPI bus and XDG dirs. GDM's daemon and AccountsService are
# scripts/lib/tuna-gdm-mock.py on a private system bus (a dbus-daemon with
# a permissive test policy) handed to the compositor only as
# DBUS_SYSTEM_BUS_ADDRESS: Manager.OpenSession returns the address of a
# GDBusServer on unix:dir= (GDM's /run/gdm/dbus), whose
# /org/gnome/DisplayManager/Session serves UserVerifier and Greeter as GDM
# 51.1.1 does, with logind and gsd-smartcard alongside, and a control
# interface the proof uses to insert the card, install gdm-switchable-auth,
# configure timed login and restart the greeter's channel. Users ada,
# grace, katherine, dorothy (a second factor), mary (a running session),
# annie (a remote session GDM does not manage), hedy (the smartcard's) and
# joan (SSSD web login) are listed; gdm-greeter (system) and mallory
# (locked) are not.
# The sessions are fixture wayland-sessions Tuna (tuna, GDM's fallback, as
# TunaOS sets FallbackSession=tuna) and GNOME (gnome). NOTIFY_SOCKET is a
# datagram socket of this proof. Gates (assertions.txt carries the ID):
#   G-GREETER-READY      the greeter's layer maps, the compositor sends
#                        READY=1 once, the greeter registers with GDM
#   G-GREETER-USER-LIST  the listed fixture users show (no system or locked
#                        account), each a row with an avatar
#   G-GREETER-NO-SHELL   only the tuna-greeter layer; no shell process;
#                        Super, the hot corner and Super+L open no
#                        overview and no lock
#   G-GREETER-NOT-LISTED "Not listed?" asks "Username" (visible entry);
#                        the typed name begins gdm-password for it; Back
#                        cancels to the list
#   G-GREETER-GIVE-UP    three wrong passwords (allowed-failures 3) show
#                        GDM's problem each time and return to the list
#   G-GREETER-SESSION    Login Options shows GDM's default Tuna checked;
#                        GNOME goes to SelectSession and is selected again
#                        after the retry's begin; a login without a choice
#                        sends no SelectSession and starts Tuna
#   G-GREETER-WRONG-PASSWORD GDM's problem shows, gdm-password begins
#                        again, and the retry with the right password logs in
#   G-GREETER-PASSWORD   the typed secret reaches AnswerQuery (its SHA-256
#                        matches; it is in no log or artifact)
#   G-GREETER-START      StartSessionWhenReady(gdm-password, true) after
#                        VerificationComplete and SessionOpened
#   G-GREETER-SUPERVISION killing tuna-greeter restarts it (new channel,
#                        user list back); with the restart budget spent the
#                        compositor exits non-zero
#   G-GREETER-MULTISTEP  after dorothy's password GDM asks 'Verification code: '
#                        (InfoQuery): a visible entry at step 2 with Back;
#                        the code reaches AnswerQuery and she logs in
#   G-GREETER-SWITCH-RETURN mary (a running GDM session) is ringed as
#                        logged in; choosing her opens her re-authentication
#                        channel (OpenReauthenticationChannel), gdm-password
#                        runs there, GDM switches to her session with no
#                        new session; users without one get AccessDenied
#                        and verify on the greeter's channel
#   G-GREETER-CONFLICT   annie's remote session conflicts: "Session Already
#                        Running"; Cancel resets at GDM, Force Stop sends
#                        StopConflictingSession and starts once logind
#                        removed the old session
#   G-GREETER-SMARTCARD  Login Options offers Smartcard; gdm-smartcard says
#                        'Please insert smart card'; gsd-smartcard's token
#                        insertion restarts it; the PIN logs hedy in
#   G-GREETER-CHOICE-LIST GDM's ChoiceList query (two certificates) shows as
#                        a list; the chosen key reaches SelectChoice
#   G-GREETER-WEB-LOGIN  SSSD's CustomJSON auth-mechanisms (eidp first):
#                        "Log In", then the dialog (message, QR code of the
#                        URL, URL, login code, Cancel back to "Log In",
#                        Done); Done replies {"eidp": {}} and joan logs in
#   G-GREETER-POLICY-AUTH enable-password-authentication=false: no Password
#                        mechanism or entry, gdm-smartcard runs instead;
#                        with switchable auth also off no username is
#                        asked (BeginVerification(gdm-smartcard))
#   G-GREETER-TIMED-LOGIN TimedLoginRequested(katherine, 8): after 5 idle
#                        seconds her row counts down 3 s; a key starts it
#                        over; then BeginAutoLogin and gdm-autologin starts
#   G-GREETER-HYGIENE    no password, code or PIN in any artifact; no panic
# Screenshots (x11grab of the nested window) and AT-SPI dumps for each step;
# A-1-user-list.png and C-1-prompt.png are the review shots against GNOME
# 51's login dialog. Writes assertions.txt and receipt.json; exits non-zero
# naming the failed gate.
set -eu

if [ -z "${TUNA_PROOF_PRIVATE_BUS:-}" ]; then
    TUNA_PROOF_PRIVATE_BUS=1 exec dbus-run-session -- "$0" "$@"
fi
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/greeter-artifacts"
WIDTH=1280
HEIGHT=800
while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --help|-h) sed -n '2,79p' "$0"; exit 0 ;;
        *) echo "tuna-greeter-proof: unknown argument $1" >&2; exit 2 ;;
    esac
done
mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/nested.log"
ASSERTIONS="$ARTIFACTS/assertions.txt"
CSTATE="$ARTIFACTS/compositor-state.json"
GDM_LOG="$ARTIFACTS/gdm-calls.jsonl"
NOTIFY_LOG="$ARTIFACTS/notify.log"
: >"$ASSERTIONS"
: >"$LOG"
: >"$GDM_LOG"
: >"$NOTIFY_LOG"
rm -f "$ARTIFACTS/receipt.json" "$CSTATE" "$ARTIFACTS"/*.png "$ARTIFACTS"/a11y-*.json "$ARTIFACTS"/a11y-*.err
PY=/usr/bin/python3
[ -x "$PY" ] || PY=python3
ORIG_HOME="$HOME"
BIN_DIR="${TUNA_PROOF_BIN_DIR:-${CARGO_TARGET_DIR:-$ROOT/target}/debug}"

# Private runtime (AF_UNIX paths stay short) and XDG/HOME directories.
RUN_PRIV="$(mktemp -d "${TMPDIR:-/tmp}/tuna-grp.XXXXXX")"
chmod 700 "$RUN_PRIV"
HOME="$ARTIFACTS/home"
XDG_RUNTIME_DIR="$RUN_PRIV"
XDG_CONFIG_HOME="$ARTIFACTS/config"
XDG_DATA_HOME="$ARTIFACTS/data"
XDG_CACHE_HOME="$ARTIFACTS/cache"
XDG_STATE_HOME="$ARTIFACTS/state"
FIXTURE="$ARTIFACTS/fixture"
rm -rf "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$FIXTURE"
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" \
    "$FIXTURE/share/wayland-sessions"
# GDM's greeter environment (docs/greeter.md): its own data dir first,
# the supported session types, keyfile settings in the private config.
XDG_DATA_DIRS="$FIXTURE/share:/usr/local/share:/usr/share"
GDM_SUPPORTED_SESSION_TYPES=wayland
GSETTINGS_BACKEND=keyfile
TUNA_COMPOSITOR_STATE="$CSTATE"
TUNA_XWAYLAND=0
export HOME XDG_RUNTIME_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME \
    XDG_DATA_DIRS GDM_SUPPORTED_SESSION_TYPES GSETTINGS_BACKEND TUNA_COMPOSITOR_STATE TUNA_XWAYLAND
# GDM's own org.gnome.login-screen (GDM 51.1.1, verbatim), compiled for
# this run; keys are set with gsettings on the keyfile backend.
GSETTINGS_SCHEMA_DIR="$FIXTURE/schemas"
export GSETTINGS_SCHEMA_DIR
unset WAYLAND_DISPLAY WAYLAND_SOCKET DBUS_SYSTEM_BUS_ADDRESS AT_SPI_BUS_ADDRESS NOTIFY_SOCKET \
    GDM_MESSAGE_TIME_MULTIPLIER TUNA_GREETER_BIN TUNA_SHELL_BIN XDG_SESSION_ID

# Secrets of this run only: never written below $ARTIFACTS.
secret() { echo "$1-$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"; }
ADA_PASSWORD="$(secret ada)"
GRACE_PASSWORD="$(secret grace)"
KATHERINE_PASSWORD="$(secret katherine)"
WRONG_PASSWORD="$(secret nope)"
DOROTHY_PASSWORD="$(secret dorothy)"
DOROTHY_CODE="$(secret code)"
MARY_PASSWORD="$(secret mary)"
ANNIE_PASSWORD="$(secret annie)"
HEDY_PASSWORD="$(secret hedy)"
JOAN_PASSWORD="$(secret joan)"
CARD_PIN="$(secret pin)"

XVFB_PID=""
ATSPI_PID=""
SYSBUS_PID=""
MOCK_PID=""
NOTIFY_PID=""
COMPOSITOR_PID=""
COMPOSITOR_STATUS=""
GREETER_PID=""
WID=""
CURRENT_GATE="SETUP"
FAILED_GATE=""

pass() {
    echo "$1 pass $2" >>"$ASSERTIONS"
    echo "tuna-greeter-proof: $1 pass: $2"
}
fail() {
    FAILED_GATE="$1"
    echo "$1 fail $2" >>"$ASSERTIONS"
    echo "tuna-greeter-proof: $1 FAIL: $2" >&2
    tail -40 "$LOG" >&2 2>/dev/null || true
    exit 1
}

# Every process this proof started carries XDG_RUNTIME_DIR=$RUN_PRIV.
owned_pids() {
    : >"$ARTIFACTS/owned-pids.txt"
    for environ in /proc/[0-9]*/environ; do
        pid="${environ#/proc/}"
        pid="${pid%/environ}"
        [ "$pid" = "$$" ] && continue
        if tr '\0' '\n' 2>/dev/null <"$environ" | grep -qxF "XDG_RUNTIME_DIR=$RUN_PRIV"; then
            echo "$pid" >>"$ARTIFACTS/owned-pids.txt"
        fi
    done
}

stop_pid() {
    [ -n "$1" ] || return 0
    kill "$1" 2>/dev/null || return 0
    for _ in $(seq 1 50); do kill -0 "$1" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$1" 2>/dev/null || true
    wait "$1" 2>/dev/null || true
}

finish() {
    status=$?
    set +e
    trap - EXIT INT TERM
    if [ "$status" != 0 ] && [ -z "$FAILED_GATE" ]; then
        FAILED_GATE="$CURRENT_GATE"
        echo "$CURRENT_GATE fail exited with status $status" >>"$ASSERTIONS"
    fi
    [ -s "$CSTATE" ] && cp "$CSTATE" "$ARTIFACTS/final-state.json"
    stop_pid "$COMPOSITOR_PID"
    stop_pid "$MOCK_PID"
    stop_pid "$NOTIFY_PID"
    stop_pid "$SYSBUS_PID"
    stop_pid "$ATSPI_PID"
    stop_pid "$XVFB_PID"
    owned_pids
    swept=""
    while read -r pid; do
        comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo gone)"
        kill "$pid" 2>/dev/null && swept="$swept $pid:$comm"
    done <"$ARTIFACTS/owned-pids.txt"
    [ -n "$swept" ] && sleep 1
    while read -r pid; do kill -9 "$pid" 2>/dev/null; done <"$ARTIFACTS/owned-pids.txt"
    sleep 0.3
    owned_pids
    cp "$ARTIFACTS/owned-pids.txt" "$ARTIFACTS/leftover-pids.txt"
    rm -rf "$RUN_PRIV"
    leftover="$(tr '\n' ' ' <"$ARTIFACTS/leftover-pids.txt")"
    if [ -n "$leftover" ]; then
        echo "CLEANUP fail processes outlived the proof: $leftover" >>"$ASSERTIONS"
        [ -n "$FAILED_GATE" ] || FAILED_GATE=CLEANUP
    fi
    if [ -e "$RUN_PRIV" ]; then
        echo "CLEANUP fail $RUN_PRIV remains" >>"$ASSERTIONS"
        FAILED_GATE="${FAILED_GATE:-CLEANUP}"
    fi
    "$PY" - "$ARTIFACTS" "$ROOT" "$BIN_DIR" "$FAILED_GATE" "$swept" "$COMPOSITOR_STATUS" <<'RECEIPT'
import hashlib, json, pathlib, subprocess, sys
out, root, bins, failed, swept, status = (pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]),
                                          pathlib.Path(sys.argv[3]), sys.argv[4], sys.argv[5].split(), sys.argv[6])
def sha(path):
    try:
        return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
    except OSError:
        return None
def git(*args):
    try:
        return subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
gates = []
for line in (out / 'assertions.txt').read_text().splitlines():
    gate, verdict, detail = (line.split(' ', 2) + ['', ''])[:3]
    gates.append({'gate': gate, 'verdict': verdict, 'detail': detail})
state = git('status', '--porcelain', '--untracked-files=no')
receipt = {
    'proof': 'tuna-greeter-proof', 'issue': 1164, 'ledger': 'P-LK-03',
    'result': 'fail' if failed else 'pass', 'failed_gate': failed or None,
    'source': {'head': git('rev-parse', 'HEAD'), 'dirty': bool(state),
               'status_sha256': hashlib.sha256((state or '').encode()).hexdigest()},
    'binaries': {name: sha(bins / name) for name in ('tuna-compositor', 'tuna-greeter')},
    'fixtures': {name: sha(root / name) for name in (
        'scripts/tuna-greeter-proof', 'scripts/lib/tuna-gdm-mock.py', 'scripts/lib/tuna-a11y-dump.py')},
    'bin_dir': str(bins), 'gates': gates,
    'compositor_exit_status': int(status) if status.isdigit() else None,
    'review_screenshots': ['A-1-user-list.png', 'C-1-prompt.png', 'C-2-wrong-password.png',
                           'F-2-code.png', 'G-2-conflict.png', 'H-1-insert.png',
                           'H-2-choice.png', 'I-2-web-login.png', 'J-1-policy.png',
                           'K-1-timed.png'],
    'cleanup': {'swept_pids': swept,
                'leftover_pids': (out / 'leftover-pids.txt').read_text().split()},
    'scope': 'nested winit session on Xvfb; GDM 51 greeter API and AccountsService as a D-Bus '
             'mock on a private system bus; real compositor (--greeter), tuna-greeter, GTK '
             'widgets, X11 input and AT-SPI',
    'not_covered': ['GDM itself: PAM, the session worker, VT handoff and session start',
                    'gnome-session --session gnome-login and tuna-greeter.service (V-GDM-LOGIN)',
                    'DRM hardware, the dynamic greeter user and GDM\'s uid checks',
                    'fingerprint: GDM 51 offers it only for re-authentication and the '
                    'login dialog never starts it (not applicable)',
                    'real SSSD, pam_sss, a smartcard reader and an identity provider'],
}
(out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
RECEIPT
    if [ -n "$FAILED_GATE" ]; then
        echo "tuna-greeter-proof: FAILED $FAILED_GATE (artifacts in $ARTIFACTS)" >&2
        exit 1
    fi
    echo "tuna-greeter-proof: OK, artifacts in $ARTIFACTS"
    exit 0
}
trap finish EXIT
trap 'exit 130' INT TERM

alive() { [ -n "$COMPOSITOR_PID" ] && kill -0 "$COMPOSITOR_PID" 2>/dev/null; }
cstate() {
    end=$(($(date +%s) + ${2:-20}))
    while [ "$(date +%s)" -le "$end" ]; do
        alive || return 1
        [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    return 1
}

# Nested log: `mark` it, then wait for an exact greeter trace line after
# the mark (`twait`); prints the line number.
mark() { wc -l <"$LOG" | tr -d ' '; }
twait() {
    from="$1" text="tuna-greeter: $2" end=$(($(date +%s) + ${3:-20}))
    while :; do
        n="$(tail -n "+$((from + 1))" "$LOG" | grep -n -Fx -m1 -- "$text" | cut -d: -f1 || true)"
        if [ -n "$n" ]; then echo $((from + n)); return 0; fi
        [ "$(date +%s)" -ge "$end" ] && return 1
        alive || return 1
        sleep 0.2
    done
}

# The GDM mock's log: `gmark`, then `gwait MARK JQ [TIMEOUT]` until an
# entry after the mark satisfies the predicate; `gcount MARK JQ` counts.
gmark() { wc -l <"$GDM_LOG" | tr -d ' '; }
gsel() { tail -n "+$(($1 + 1))" "$GDM_LOG" | jq -c "select($2)"; }
gcount() { gsel "$1" "$2" | wc -l | tr -d ' '; }
gwait() {
    end=$(($(date +%s) + ${3:-20}))
    while :; do
        [ "$(gcount "$1" "$2")" -gt 0 ] && return 0
        [ "$(date +%s)" -ge "$end" ] && return 1
        sleep 0.2
    done
}
call() { echo ".kind == \"call\" and .member == \"$1\"${2:+ and $2}"; }
sig() { echo ".kind == \"signal\" and .member == \"$1\"${2:+ and $2}"; }
# The line (1-based, absolute) of the first entry after MARK matching JQ.
gline() {
    tail -n "+$(($1 + 1))" "$GDM_LOG" | jq -c "($2)" | grep -n -m1 -x true | cut -d: -f1 |
        { read -r n && echo $(($1 + n)); } || true
}
sha() { printf %s "$1" | sha256sum | cut -d' ' -f1; }

greeter_pid() { pgrep -P "$COMPOSITOR_PID" -x tuna-greeter | head -1 || true; }
# A greeter other than $1 runs (the compositor restarted it).
await_greeter() {
    end=$(($(date +%s) + ${2:-30}))
    while :; do
        pid="$(greeter_pid)"
        if [ -n "$pid" ] && [ "$pid" != "${1:-}" ]; then GREETER_PID="$pid"; return 0; fi
        [ "$(date +%s)" -ge "$end" ] && return 1
        alive || return 1
        sleep 0.1
    done
}

# AT-SPI dump of the running greeter.
dump() {
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-greeter "$ARTIFACTS/a11y-$1.json" 20 \
        --pid "$GREETER_PID" "${@:2}" >/dev/null 2>"$ARTIFACTS/a11y-$1.err" ||
        fail "$CURRENT_GATE" "accessibility dump $1 failed"
}
showing() { jq -e --arg n "$2" 'any(.[]; .name == $n and .showing)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
hidden() { ! showing "$@"; }
role_of() {
    jq -r --arg n "$2" 'first(.[] | select(.name == $n and .showing and .role != "label")) | .role' \
        "$ARTIFACTS/a11y-$1.json"
}
checked() { jq -e --arg n "$2" 'any(.[]; .name == $n and .checked)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
shot() {
    geom="$(xdotool getwindowgeometry --shell "$WID")"
    gx="$(echo "$geom" | sed -n 's/^X=//p')"
    gy="$(echo "$geom" | sed -n 's/^Y=//p')"
    ffmpeg -loglevel error -y -f x11grab -draw_mouse 0 -video_size "${WIDTH}x${HEIGHT}" \
        -i "$DISPLAY+$gx,$gy" -frames:v 1 "$ARTIFACTS/$1.png" ||
        fail "$CURRENT_GATE" "x11grab of the nested window failed for $1"
}
# Choose the INDEXth user of the list with the keyboard, as GDM's list is
# driven: the first row has the focus, Down moves, Return activates. (GTK
# 4.14 adds a GtkStack page's offset twice to its children's AT-SPI
# extents, so the stack's pages are not clicked by their bounds.)
pick_user() {
    for _ in $(seq 1 "$1"); do xdotool key Down; sleep 0.2; done
    xdotool key Return
}
focused() { jq -e --arg n "$2" 'any(.[]; .name == $n and .showing and .focused)' "$ARTIFACTS/a11y-$1.json" >/dev/null; }
answer() {
    xdotool type --delay 40 "$1"
    xdotool key Return
}

# The mock's controls (the proof's hand on GDM, the card and SSSD).
control() {
    gdbus call --address "$SYS_ADDR" --dest org.gnome.DisplayManager \
        --object-path /org/tuna/Proof/GdmMock --method "org.tuna.Proof.GdmMock.$1" "${@:2}" \
        >/dev/null 2>>"$ARTIFACTS/control.err" || fail "$CURRENT_GATE" "the GDM mock refused $1"
}
# GDM restarts the greeter's channel (the login before it is done); the
# greeter connects again and shows its user list.
new_channel() {
    nc="$(mark)"
    control CloseGreeterChannels
    twait "$nc" "greeter gdm-connected" 20 >/dev/null || fail "$CURRENT_GATE" "the greeter did not reconnect to GDM"
    sleep 1
}
description() {
    jq -r --arg n "$2" 'first(.[] | select(.name == $n and .role == "list item")) | .description' \
        "$ARTIFACTS/a11y-$1.json"
}
# The wall time of the first entry after MARK matching JQ.
wall_of() { gsel "$1" "$2" | head -1 | jq -r .wall; }

GDM_FAILED="Sorry, password authentication didn’t work. Please try again."

# The user's gdm-password conversation is asking for the password after
# the mark: the mock's SecretInfoQuery, then the entry on screen.
await_password_prompt() {
    gwait "$1" "$(sig SecretInfoQuery '.args == ["gdm-password", "Password: "]')" 20 ||
        fail "$CURRENT_GATE" "GDM's 'Password: ' query never came ($2)"
    sleep 0.5
    dump "$2"
    showing "$2" "Password" || fail "$CURRENT_GATE" "no showing Password entry ($2)"
    [ "$(role_of "$2" Password)" = "password text" ] ||
        fail "$CURRENT_GATE" "the Password entry is not a hidden-text entry ($2)"
}
# Answer the focused password entry of a dump.
type_password() {
    focused "$1" "Password" || fail "$CURRENT_GATE" "the Password entry does not have the keyboard focus ($1)"
    answer "$2"
}

# --- environment ------------------------------------------------------
for tool in Xvfb xdotool ffmpeg jq gdbus dbus-daemon pgrep sha256sum gsettings glib-compile-schemas; do
    command -v "$tool" >/dev/null 2>&1 || fail SETUP "$tool is required"
done

if [ -x /usr/libexec/at-spi-bus-launcher ]; then
    /usr/libexec/at-spi-bus-launcher --launch-immediately >"$ARTIFACTS/atspi.log" 2>&1 &
    ATSPI_PID=$!
    AT_SPI_BUS_ADDRESS="$("$PY" - <<'AT_SPI_ADDRESS'
import time
from gi.repository import Gio
bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
end = time.monotonic() + 10
while True:
    try:
        reply = bus.call_sync('org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Bus', 'GetAddress',
                              None, None, Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        print(reply.unpack()[0])
        break
    except Exception:
        if time.monotonic() >= end:
            raise
        time.sleep(0.1)
AT_SPI_ADDRESS
)" || fail SETUP "the private accessibility bus did not start"
    export AT_SPI_BUS_ADDRESS
else
    fail SETUP "at-spi-bus-launcher is required for the accessibility dumps"
fi

[ -n "$DISPLAY_ARG" ] && DISPLAY="$DISPLAY_ARG" && export DISPLAY
if [ -z "$DISPLAY_ARG" ]; then
    "$ROOT/scripts/lib/tuna-xvfb" -displayfd 3 -screen 0 "${WIDTH}x${HEIGHT}x24" -nolisten tcp \
        3>"$ARTIFACTS/xvfb-display" >"$ARTIFACTS/xvfb.log" 2>&1 &
    XVFB_PID=$!
    for _ in $(seq 1 30); do [ -s "$ARTIFACTS/xvfb-display" ] && break; sleep 0.5; done
    [ -s "$ARTIFACTS/xvfb-display" ] || fail SETUP "Xvfb did not allocate a display"
    DISPLAY=":$(cat "$ARTIFACTS/xvfb-display")"
    export DISPLAY
else
    Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" -nolisten tcp >"$ARTIFACTS/xvfb.log" 2>&1 &
    XVFB_PID=$!
fi
for _ in $(seq 1 30); do xdotool getdisplaygeometry >/dev/null 2>&1 && break; sleep 0.5; done
xdotool getdisplaygeometry >/dev/null 2>&1 || fail SETUP "no X display at $DISPLAY"

if [ -z "${TUNA_PROOF_BIN_DIR:-}" ]; then
    RUSTUP_HOME="${RUSTUP_HOME:-$ORIG_HOME/.rustup}" CARGO_HOME="${CARGO_HOME:-$ORIG_HOME/.cargo}" \
        cargo build --locked --quiet --manifest-path "$ROOT/Cargo.toml" -p tuna-compositor -p tuna-greeter ||
        fail SETUP "cargo build failed"
fi
for bin in tuna-compositor tuna-greeter; do
    [ -x "$BIN_DIR/$bin" ] || fail SETUP "$BIN_DIR/$bin is missing"
done

# The sessions GDM would offer (gnome-greeter's data dir comes first).
printf '[Desktop Entry]\nName=Tuna\nComment=Tuna Desktop\nExec=tuna-session\nType=Application\n' \
    >"$FIXTURE/share/wayland-sessions/tuna.desktop"
printf '[Desktop Entry]\nName=GNOME\nComment=GNOME\nExec=gnome-session\nType=Application\n' \
    >"$FIXTURE/share/wayland-sessions/gnome.desktop"
# Hide the host's other sessions as libgdm honours it (an earlier data
# dir's Hidden=true file wins), so the menu is GNOME then Tuna everywhere.
for desktop in /usr/local/share/wayland-sessions/*.desktop /usr/share/wayland-sessions/*.desktop; do
    [ -e "$desktop" ] || continue
    case "${desktop##*/}" in tuna.desktop | gnome.desktop) continue ;; esac
    printf '[Desktop Entry]\nName=hidden\nType=Application\nHidden=true\n' \
        >"$FIXTURE/share/wayland-sessions/${desktop##*/}"
done
cat >"$FIXTURE/users.json" <<'USERS'
[
  {"name": "ada", "real_name": "Ada Lovelace", "uid": 1001},
  {"name": "grace", "real_name": "Grace Hopper", "uid": 1002},
  {"name": "katherine", "real_name": "Katherine Johnson", "uid": 1003},
  {"name": "dorothy", "real_name": "Dorothy Vaughan", "uid": 1005, "second_factor": true},
  {"name": "mary", "real_name": "Mary Jackson", "uid": 1006,
   "logged_in": {"id": "7", "managed": true}},
  {"name": "annie", "real_name": "Annie Easley", "uid": 1007,
   "logged_in": {"id": "9", "managed": false, "remote": true}},
  {"name": "hedy", "real_name": "Hedy Lamarr", "uid": 1008},
  {"name": "joan", "real_name": "Joan Clarke", "uid": 1009,
   "switchable": {"authSelection": {"mechanisms": {
     "password": {"name": "Password", "role": "password", "selectable": true, "prompt": "Password"},
     "eidp": {"name": "Web Login", "role": "eidp", "selectable": true, "initPrompt": "Log In",
              "linkPrompt": "Log in online with another device",
              "uri": "https://idp.example.org/device/", "code": "4219-7730", "timeout": 300}},
     "priority": ["eidp", "password"]}}},
  {"name": "gdm-greeter", "real_name": "GDM Greeter", "uid": 60578, "system": true},
  {"name": "mallory", "real_name": "Locked Account", "uid": 1004, "locked": true}
]
USERS
printf 'ada:%s\ngrace:%s\nkatherine:%s\ndorothy:%s\ndorothy@code:%s\nmary:%s\nannie:%s\nhedy:%s\njoan:%s\nsmartcard@pin:%s\n' \
    "$ADA_PASSWORD" "$GRACE_PASSWORD" "$KATHERINE_PASSWORD" "$DOROTHY_PASSWORD" "$DOROTHY_CODE" \
    "$MARY_PASSWORD" "$ANNIE_PASSWORD" "$HEDY_PASSWORD" "$JOAN_PASSWORD" "$CARD_PIN" \
    >"$RUN_PRIV/secrets"
chmod 600 "$RUN_PRIV/secrets"
mkdir -p "$GSETTINGS_SCHEMA_DIR"
cp "$ROOT/scripts/lib/org.gnome.login-screen.gschema.xml" "$GSETTINGS_SCHEMA_DIR/"
glib-compile-schemas "$GSETTINGS_SCHEMA_DIR" || fail SETUP "glib-compile-schemas failed"
gsettings get org.gnome.login-screen enable-password-authentication >/dev/null ||
    fail SETUP "org.gnome.login-screen is not readable"

# The private "system" bus: GDM's and AccountsService's only home here.
cat >"$RUN_PRIV/system-bus.conf" <<BUSCONF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>tuna-proof-system</type>
  <listen>unix:path=$RUN_PRIV/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_type="method_call"/>
    <allow send_type="signal"/>
    <allow send_type="method_return"/>
    <allow send_type="error"/>
    <allow receive_type="method_call"/>
    <allow receive_type="method_return"/>
    <allow receive_type="error"/>
    <allow receive_type="signal"/>
  </policy>
</busconfig>
BUSCONF
dbus-daemon --config-file="$RUN_PRIV/system-bus.conf" --nofork --print-address=3 \
    3>"$RUN_PRIV/system-bus-address" >"$ARTIFACTS/system-bus.log" 2>&1 &
SYSBUS_PID=$!
for _ in $(seq 1 50); do [ -s "$RUN_PRIV/system-bus-address" ] && break; sleep 0.1; done
SYS_ADDR="$(head -1 "$RUN_PRIV/system-bus-address")"
case "$SYS_ADDR" in unix:path=*) ;; *) fail SETUP "the private system bus did not start" ;; esac

mkdir -m 711 "$RUN_PRIV/gdm-dbus"
"$PY" "$ROOT/scripts/lib/tuna-gdm-mock.py" --address "$SYS_ADDR" --server-dir "$RUN_PRIV/gdm-dbus" \
    --log "$GDM_LOG" --users "$FIXTURE/users.json" --secrets "$RUN_PRIV/secrets" \
    --sessions tuna,gnome --fallback-session tuna --smartcard-user hedy --smartcard-certs 2 \
    >"$ARTIFACTS/gdm-mock.out" 2>"$ARTIFACTS/gdm-mock.err" &
MOCK_PID=$!
for _ in $(seq 1 50); do grep -q '^tuna-gdm-mock: ready ' "$ARTIFACTS/gdm-mock.out" && break; sleep 0.1; done
grep -q '^tuna-gdm-mock: ready ' "$ARTIFACTS/gdm-mock.out" || fail SETUP "the GDM mock did not start"

# systemd's side of Type=notify: one datagram socket, every message logged.
"$PY" - "$RUN_PRIV/notify" "$NOTIFY_LOG" <<'NOTIFY' &
import socket, sys, time
sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
sock.bind(sys.argv[1])
with open(sys.argv[2], 'a', encoding='utf-8') as out:
    while True:
        data = sock.recv(4096).decode(errors='replace')
        out.write(f'{time.time():.3f} {data}\n')
        out.flush()
NOTIFY
NOTIFY_PID=$!
for _ in $(seq 1 50); do [ -S "$RUN_PRIV/notify" ] && break; sleep 0.1; done
[ -S "$RUN_PRIV/notify" ] || fail SETUP "the notify socket did not appear"

{
    echo "source $(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
    sha256sum "$BIN_DIR/tuna-compositor" "$BIN_DIR/tuna-greeter"
} >"$ARTIFACTS/manifest.txt"

env DBUS_SYSTEM_BUS_ADDRESS="$SYS_ADDR" NOTIFY_SOCKET="$RUN_PRIV/notify" \
    TUNA_GREETER_BIN="$BIN_DIR/tuna-greeter" TUNA_GREETER_TRACE=1 RUST_BACKTRACE=1 \
    "$BIN_DIR/tuna-compositor" --backend winit --socket "tuna-greeter-$$" --greeter >>"$LOG" 2>&1 &
COMPOSITOR_PID=$!
for _ in $(seq 1 90); do
    alive || fail SETUP "the compositor exited during startup"
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    [ -n "$WID" ] && break
    sleep 1
done
[ -n "$WID" ] || fail SETUP "no nested window"
xdotool windowfocus --sync "$WID"

# --- A: the login screen comes up ---------------------------------------
CURRENT_GATE=G-GREETER-READY
cstate '.layers | any(.namespace == "tuna-greeter")' 120 || fail G-GREETER-READY "the greeter's layer never mapped"
await_greeter "" 10 || fail G-GREETER-READY "no tuna-greeter child of the compositor"
for _ in $(seq 1 50); do grep -q ' READY=1$' "$NOTIFY_LOG" && break; sleep 0.1; done
grep -q ' READY=1$' "$NOTIFY_LOG" || fail G-GREETER-READY "no READY=1 on NOTIFY_SOCKET after the greeter mapped"
grep -qFx "tuna-compositor: greeter mapped; READY=1" "$LOG" ||
    fail G-GREETER-READY "READY=1 was not sent for the mapped greeter"
gwait 0 "$(call OpenSession)" 20 || fail G-GREETER-READY "the greeter never asked GDM for its channel"
gwait 0 '.kind == "connect"' 20 || fail G-GREETER-READY "the greeter never connected to GDM's session server"
gwait 0 "$(call RegisterSession)" 20 || fail G-GREETER-READY "the greeter did not register its session with GDM"
gwait 0 "$(call RegisterDisplay)" 20 || fail G-GREETER-READY "the greeter did not register its display with GDM"
pass G-GREETER-READY "the tuna-greeter layer mapped and READY=1 reached NOTIFY_SOCKET; OpenSession, the peer channel and RegisterSession/RegisterDisplay reached GDM"

CURRENT_GATE=G-GREETER-USER-LIST
m="$(mark)"
twait 0 "greeter users names=ada,grace,katherine,dorothy,mary,annie,hedy,joan" 20 >/dev/null ||
    fail G-GREETER-USER-LIST "the greeter did not list exactly the eight fixture users"
twait 0 "greeter logged-in names=mary,annie" 20 >/dev/null ||
    fail G-GREETER-USER-LIST "logind's logged-in users (mary, annie) were not read"
gwait 0 "$(call ListCachedUsers)" 5 || fail G-GREETER-USER-LIST "AccountsService was not asked for its users"
sleep 1.5
dump A-1-user-list
shot A-1-user-list
for name in "Ada Lovelace" "Grace Hopper" "Katherine Johnson" "Not listed?"; do
    showing A-1-user-list "$name" || fail G-GREETER-USER-LIST "'$name' is not showing"
done
for name in "GDM Greeter" "Locked Account" "Password"; do
    hidden A-1-user-list "$name" || fail G-GREETER-USER-LIST "'$name' shows on the user list"
done
rows="$(jq '[.[] | select(.showing and (.role == "list item") and (.name | IN("Ada Lovelace", "Grace Hopper", "Katherine Johnson")))] | length' "$ARTIFACTS/a11y-A-1-user-list.json")"
[ "$rows" = 3 ] || fail G-GREETER-USER-LIST "$rows user rows instead of 3"
[ "$(description A-1-user-list "Mary Jackson")" = "Logged in" ] ||
    fail G-GREETER-USER-LIST "Mary Jackson's row is not marked logged in"
[ "$(description A-1-user-list "Annie Easley")" = "Logged in" ] ||
    fail G-GREETER-USER-LIST "Annie Easley's row is not marked logged in"
[ "$(description A-1-user-list "Ada Lovelace")" = "" ] ||
    fail G-GREETER-USER-LIST "Ada Lovelace's row is marked logged in"
pass G-GREETER-USER-LIST "Ada Lovelace, Grace Hopper and Katherine Johnson listed first as rows with Not listed?, eight users in all, Mary Jackson and Annie Easley marked logged in (logind); the system and locked accounts are not (A-1-user-list.png)"

CURRENT_GATE=G-GREETER-NO-SHELL
namespaces="$(jq -c '[.layers[].namespace] | unique' "$CSTATE")"
[ "$namespaces" = '["tuna-greeter"]' ] || fail G-GREETER-NO-SHELL "layers other than the greeter's: $namespaces"
children="$(pgrep -P "$COMPOSITOR_PID" -l | awk '{print $2}' | sort | tr '\n' ' ')"
case " $children " in *" tuna-shell-gtk "* | *" tuna-shell "*) fail G-GREETER-NO-SHELL "a shell runs: $children" ;; esac
xdotool key --clearmodifiers super
sleep 1
xdotool mousemove --window "$WID" 0 0
sleep 1.5
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key --clearmodifiers super+l
sleep 1.5
jq -e '.overview_open == false and .locked == false and ([.layers[].namespace] | unique) == ["tuna-greeter"]' "$CSTATE" >/dev/null ||
    fail G-GREETER-NO-SHELL "Super, the hot corner or Super+L changed the login screen: $(jq -c '{overview_open, locked, layers: [.layers[].namespace]}' "$CSTATE")"
pass G-GREETER-NO-SHELL "layers $namespaces only; compositor children: $children; Super, the hot corner and Super+L left overview_open=false and locked=false"

# --- B: Not listed? -----------------------------------------------------
CURRENT_GATE=G-GREETER-NOT-LISTED
m="$(mark)"; g="$(gmark)"
dump B-0-not-listed --press "Not listed?"
twait "$m" "greeter page username" 10 >/dev/null || fail G-GREETER-NOT-LISTED "Not listed? did not ask for a username"
sleep 0.5
dump B-1-username
shot B-1-username
showing B-1-username "Username" || fail G-GREETER-NOT-LISTED "no showing Username entry"
[ "$(role_of B-1-username Username)" != "password text" ] || fail G-GREETER-NOT-LISTED "the Username entry hides its text"
[ "$(gcount "$g" "$(call BeginVerificationForUser)")" = 0 ] ||
    fail G-GREETER-NOT-LISTED "verification began before a username was typed"
answer dave
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "dave"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-NOT-LISTED "the typed username did not begin gdm-password for dave"
await_password_prompt "$g" B-2-password
shot B-2-password
showing B-2-password "dave" || fail G-GREETER-NOT-LISTED "the prompt does not name dave"
m="$(mark)"; g2="$(gmark)"
xdotool key Escape
gwait "$g2" "$(call Cancel)" 10 || fail G-GREETER-NOT-LISTED "Back did not cancel the conversation"
gwait "$g2" "$(sig ConversationStopped '.args == ["gdm-password"]')" 10 ||
    fail G-GREETER-NOT-LISTED "GDM's conversation did not stop after Cancel"
twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-NOT-LISTED "Back did not return to the user list"
sleep 0.5
dump B-3-back
showing B-3-back "Ada Lovelace" || fail G-GREETER-NOT-LISTED "the user list is not back"
hidden B-3-back "Password" || fail G-GREETER-NOT-LISTED "the prompt still shows"
pass G-GREETER-NOT-LISTED "Not listed? asked 'Username' (visible entry); 'dave' began gdm-password for dave with a hidden Password prompt; Back sent Cancel and returned to the list"

# --- D: allowed-failures --------------------------------------------------
CURRENT_GATE=G-GREETER-GIVE-UP
m="$(mark)"; g="$(gmark)"
pick_user 2
twait "$m" "greeter page prompt user=katherine" 10 >/dev/null || fail G-GREETER-GIVE-UP "the prompt did not open for katherine"
for try in 1 2 3; do
    gt="$(gmark)"
    if [ "$try" = 1 ]; then gt="$g"; fi
    await_password_prompt "$gt" "D-$try-password"
    gq="$(gmark)"
    type_password "D-$try-password" "$WRONG_PASSWORD-$try"
    gwait "$gq" "$(call AnswerQuery '.detail.matches_password == false and .detail.user == "katherine"')" 10 ||
        fail G-GREETER-GIVE-UP "wrong answer $try did not reach AnswerQuery"
    gwait "$gq" "$(sig VerificationFailed)" 10 || fail G-GREETER-GIVE-UP "GDM did not fail answer $try"
    sleep 0.5
    dump "D-$try-problem"
    showing "D-$try-problem" "$GDM_FAILED" || fail G-GREETER-GIVE-UP "GDM's problem is not shown after try $try"
    [ "$try" = 1 ] && shot D-1-problem
done
twait "$m" "greeter give-up" 20 >/dev/null || fail G-GREETER-GIVE-UP "the greeter did not give up after three failures"
twait "$m" "greeter page users" 20 >/dev/null || fail G-GREETER-GIVE-UP "the greeter did not return to the user list"
sleep 1
dump D-4-list
shot D-4-list
showing D-4-list "Katherine Johnson" || fail G-GREETER-GIVE-UP "the user list is not showing"
hidden D-4-list "Password" || fail G-GREETER-GIVE-UP "the prompt still shows after giving up"
begins="$(gcount "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "katherine"]')")"
[ "$begins" = 3 ] || fail G-GREETER-GIVE-UP "$begins begins for katherine instead of 3"
[ "$(gcount "$g" "$(sig VerificationFailed '.args == ["gdm-password"]')")" = 3 ] || fail G-GREETER-GIVE-UP "not three VerificationFailed"
pass G-GREETER-GIVE-UP "three wrong answers each showed '$GDM_FAILED'; after the third (allowed-failures 3) the greeter gave up to the user list with 3 begins in all"

# --- C: wrong password, session choice, retry, start ---------------------
CURRENT_GATE=G-GREETER-SESSION
m="$(mark)"; g="$(gmark)"
pick_user 0
twait "$m" "greeter page prompt user=ada" 10 >/dev/null || fail G-GREETER-SESSION "the prompt did not open for ada"
gwait "$g" "$(sig DefaultSessionNameChanged '.args == ["tuna"]')" 10 ||
    fail G-GREETER-SESSION "GDM's default session (tuna) was not announced"
await_password_prompt "$g" C-1-prompt
shot C-1-prompt
showing C-1-prompt "Ada Lovelace" || fail G-GREETER-SESSION "the prompt does not name Ada Lovelace"
showing C-1-prompt "Login Options" || fail G-GREETER-SESSION "Login Options is not offered on the prompt"
dump C-2-options --press "Login Options"
shot C-2-options
showing C-2-options "Tuna" || fail G-GREETER-SESSION "Login Options does not list Tuna"
showing C-2-options "GNOME" || fail G-GREETER-SESSION "Login Options does not list GNOME"
checked C-2-options "Tuna" || fail G-GREETER-SESSION "GDM's default Tuna is not the checked session"
! checked C-2-options "GNOME" || fail G-GREETER-SESSION "GNOME is checked before it was chosen"
# The menu has the focus on the checked item; GNOME is the one above it.
focused C-2-options "Tuna" || fail G-GREETER-SESSION "the menu's focus is not on the checked Tuna"
gs="$(gmark)"
xdotool key Up
how="Up (a radio group selects as its focus moves)"
if ! gwait "$gs" "$(call SelectSession '.args == ["gnome"] and .outcome == "ok"')" 3; then
    xdotool key space
    how="Up, Space"
fi
gwait "$gs" "$(call SelectSession '.args == ["gnome"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SESSION "choosing GNOME did not reach SelectSession"
[ "$(gcount "$gs" "$(call SelectSession)")" = 1 ] ||
    fail G-GREETER-SESSION "choosing GNOME sent other SelectSession calls: $(gsel "$gs" "$(call SelectSession)" | jq -c .args)"
sleep 0.5
dump C-3-closed
hidden C-3-closed "Session Type" || fail G-GREETER-SESSION "Login Options stayed open after the choice"
# As GNOME's menus do, closing gives the focus back to the prompt.
focused C-3-closed "Password" || fail G-GREETER-SESSION "the Password entry did not get the focus back after the choice"
dump C-3-gnome --press "Login Options"
checked C-3-gnome "GNOME" || fail G-GREETER-SESSION "GNOME is not checked after choosing it"
! checked C-3-gnome "Tuna" || fail G-GREETER-SESSION "Tuna is still checked after choosing GNOME"
dump C-4-prompt --press "Login Options"
hidden C-4-prompt "Session Type" || fail G-GREETER-SESSION "Login Options did not close"

CURRENT_GATE=G-GREETER-WRONG-PASSWORD
gw="$(gmark)"; m="$(mark)"
type_password C-4-prompt "$WRONG_PASSWORD"
gwait "$gw" "$(call AnswerQuery '.detail.matches_password == false and .detail.user == "ada"')" 10 ||
    fail G-GREETER-WRONG-PASSWORD "the wrong answer did not reach AnswerQuery"
gwait "$gw" "$(sig Problem "(.args == [\"gdm-password\", \"$GDM_FAILED\"])")" 10 ||
    fail G-GREETER-WRONG-PASSWORD "GDM's problem was not sent"
sleep 0.5
dump C-5-wrong-password
shot C-2-wrong-password
showing C-5-wrong-password "$GDM_FAILED" || fail G-GREETER-WRONG-PASSWORD "GDM's problem is not shown"
await_password_prompt "$gw" C-6-retry
gwait "$gw" "$(call BeginVerificationForUser '.args == ["gdm-password", "ada"] and .outcome == "ok"')" 5 ||
    fail G-GREETER-WRONG-PASSWORD "gdm-password did not begin again for ada after the failure"
CURRENT_GATE=G-GREETER-SESSION
gwait "$gw" "$(call SelectSession '.args == ["gnome"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SESSION "the chosen GNOME was not selected again after the retry's begin"

CURRENT_GATE=G-GREETER-PASSWORD
gp="$(gmark)"
type_password C-6-retry "$ADA_PASSWORD"
gwait "$gp" "$(call AnswerQuery ".detail.matches_password == true and .detail.user == \"ada\" and .detail.answer_sha256 == \"$(sha "$ADA_PASSWORD")\"")" 10 ||
    fail G-GREETER-PASSWORD "ada's password did not reach AnswerQuery"
pass G-GREETER-PASSWORD "the typed password reached AnswerQuery(gdm-password) on GDM's peer channel (SHA-256 matches ada's)"
CURRENT_GATE=G-GREETER-WRONG-PASSWORD
gwait "$gp" "$(sig VerificationComplete '.args == ["gdm-password"]')" 10 ||
    fail G-GREETER-WRONG-PASSWORD "the retry did not verify"
pass G-GREETER-WRONG-PASSWORD "a wrong password showed '$GDM_FAILED' (C-2-wrong-password.png); gdm-password began again for ada and the retry verified"

CURRENT_GATE=G-GREETER-START
gwait "$gp" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 10 ||
    fail G-GREETER-START "StartSessionWhenReady(gdm-password, true) never came"
opened="$(gline "$gp" "$(sig SessionOpened)")"
complete="$(gline "$gp" "$(sig VerificationComplete)")"
started="$(gline "$gp" "$(call StartSessionWhenReady)")"
if [ -z "$opened" ] || [ -z "$complete" ] || [ "$complete" -ge "$opened" ] || [ "$opened" -ge "$started" ]; then
    fail G-GREETER-START "order VerificationComplete=$complete SessionOpened=$opened StartSessionWhenReady=$started"
fi
[ "$(gcount "$gp" "$(call StartSessionWhenReady)")" = 1 ] || fail G-GREETER-START "StartSessionWhenReady sent more than once"
selected="$(gsel "$gp" "$(call StartSessionWhenReady)" | jq -r '.detail.selected_session')"
CURRENT_GATE=G-GREETER-SESSION
[ "$selected" = gnome ] || fail G-GREETER-SESSION "GDM would start $selected, not the chosen gnome"
pass G-GREETER-START "VerificationComplete, SessionOpened, then one StartSessionWhenReady(gdm-password, true) (GDM log lines $complete, $opened, $started)"

# --- F: a second factor -------------------------------------------------
CURRENT_GATE=G-GREETER-MULTISTEP
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 3
twait "$m" "greeter page prompt user=dorothy" 10 >/dev/null || fail G-GREETER-MULTISTEP "the prompt did not open for dorothy"
await_password_prompt "$g" F-1-password
gq="$(gmark)"
type_password F-1-password "$DOROTHY_PASSWORD"
gwait "$gq" "$(call AnswerQuery '.detail.matches_password == true and .detail.user == "dorothy"')" 10 ||
    fail G-GREETER-MULTISTEP "dorothy's password did not reach AnswerQuery"
gwait "$gq" "$(sig InfoQuery '.args == ["gdm-password", "Verification code: "]')" 10 ||
    fail G-GREETER-MULTISTEP "GDM's second question never came"
twait "$m" "auth query service=password step=2 secret=false question=Verification code" 10 >/dev/null ||
    fail G-GREETER-MULTISTEP "the prompt did not take the code as its second step"
sleep 0.5
dump F-2-code
shot F-2-code
showing F-2-code "Verification code" || fail G-GREETER-MULTISTEP "no showing Verification code entry"
[ "$(role_of F-2-code "Verification code")" != "password text" ] ||
    fail G-GREETER-MULTISTEP "the code entry hides its text (InfoQuery echoes)"
focused F-2-code "Verification code" || fail G-GREETER-MULTISTEP "the code entry does not have the keyboard focus"
hidden F-2-code "Password" || fail G-GREETER-MULTISTEP "the password entry still shows"
gc="$(gmark)"
answer "$DOROTHY_CODE"
gwait "$gc" "$(call AnswerQuery ".detail.step == \"code\" and .detail.matches == true and .detail.answer_sha256 == \"$(sha "$DOROTHY_CODE")\"")" 10 ||
    fail G-GREETER-MULTISTEP "the code did not reach AnswerQuery"
gwait "$gc" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 15 ||
    fail G-GREETER-MULTISTEP "dorothy's session did not start"
pass G-GREETER-MULTISTEP "after the password GDM's InfoQuery 'Verification code: ' became step 2 (visible entry, focused, F-2-code.png); the code reached AnswerQuery (SHA-256 matches) and dorothy's session started"

# --- F: back to a running session (user switching) ------------------------
CURRENT_GATE=G-GREETER-SWITCH-RETURN
new_channel
denied="$(gcount 0 "$(call OpenReauthenticationChannel '.args == ["ada"] and .outcome == "org.freedesktop.DBus.Error.AccessDenied"')")"
[ "$denied" -ge 1 ] || fail G-GREETER-SWITCH-RETURN "ada's begins did not ask GDM for a re-authentication channel first"
m="$(mark)"; g="$(gmark)"
pick_user 4
twait "$m" "greeter page prompt user=mary" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "the prompt did not open for mary"
gwait "$g" "$(call OpenReauthenticationChannel '.args == ["mary"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SWITCH-RETURN "GDM was not asked for mary's re-authentication channel"
# Each begin asks for the channel again (the switchable service's, then,
# after the cascade, gdm-password's): follow the one gdm-password ran on.
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "mary"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SWITCH-RETURN "gdm-password did not begin for mary"
rc="$(gsel "$g" "$(call BeginVerificationForUser '.args == ["gdm-password", "mary"]')" | head -1 | jq -r .conn)"
[ "$(gcount "$g" ".kind == \"connect\" and .args == [\"mary\"] and .conn == $rc")" = 1 ] ||
    fail G-GREETER-SWITCH-RETURN "gdm-password did not begin on mary's re-authentication channel"
gwait "$g" "$(call EnableExtensions ".conn == $rc")" 10 || fail G-GREETER-SWITCH-RETURN "the extensions were not enabled on mary's channel"
await_password_prompt "$g" F-3-mary
dump F-4-options --press "Login Options"
hidden F-4-options "Session Type" || fail G-GREETER-SWITCH-RETURN "a logged-in user is offered a session type"
dump F-5-closed --press "Login Options"
gp="$(gmark)"
type_password F-5-closed "$MARY_PASSWORD"
gwait "$gp" "$(sig VerificationComplete ".args == [\"gdm-password\"] and .conn == $rc")" 10 ||
    fail G-GREETER-SWITCH-RETURN "mary's re-authentication did not verify"
gwait "$gp" '.kind == "switch" and .args[0] == "mary" and .args[1] == "7"' 10 ||
    fail G-GREETER-SWITCH-RETURN "GDM did not switch to mary's session"
twait "$m" "greeter reauthenticated user=mary" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "the greeter did not see the re-authentication succeed"
sleep 1
[ "$(gcount "$gp" "$(sig SessionOpened)")" = 0 ] || fail G-GREETER-SWITCH-RETURN "a new session was opened for mary"
[ "$(gcount "$gp" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-SWITCH-RETURN "a session was started for mary"
m2="$(mark)"
control ActivateGreeterSession
twait "$m2" "greeter login-screen-activated" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "the login screen's activation went unseen"
twait "$m2" "greeter page users" 10 >/dev/null || fail G-GREETER-SWITCH-RETURN "back on the login screen, the prompt did not reset"
pass G-GREETER-SWITCH-RETURN "Mary Jackson ringed as logged in; choosing her opened her re-authentication channel (conn $rc), gdm-password verified there, GDM switched to her session 7 with no SessionOpened or StartSessionWhenReady; ada's begins got AccessDenied first ($denied); the login screen reset when active again"

# --- G: a conflicting session -------------------------------------------
CURRENT_GATE=G-GREETER-CONFLICT
CONFLICT_TEXT="Login is not possible because a remote session is already running for annie. To login, you must log out from the remote session or force stop it."
for try in cancel force; do
    m="$(mark)"; g="$(gmark)"
    pick_user 5
    twait "$m" "greeter page prompt user=annie" 10 >/dev/null || fail G-GREETER-CONFLICT "the prompt did not open for annie"
    await_password_prompt "$g" "G-1-$try"
    gwait "$g" "$(call OpenReauthenticationChannel '.args == ["annie"] and .outcome == "org.freedesktop.DBus.Error.AccessDenied"')" 5 ||
        fail G-GREETER-CONFLICT "annie's unmanaged session got a re-authentication channel"
    type_password "G-1-$try" "$ANNIE_PASSWORD"
    gwait "$g" "$(sig SessionOpened '.args[0] == "gdm-password"')" 10 || fail G-GREETER-CONFLICT "annie's session did not open"
    twait "$m" "greeter conflict user=annie session=9 remote=true" 15 >/dev/null ||
        fail G-GREETER-CONFLICT "the conflicting session was not found"
    gwait "$g" "$(call ListSessions)" 5 || fail G-GREETER-CONFLICT "logind was not asked for the sessions"
    sleep 0.5
    dump "G-2-$try"
    [ "$try" = cancel ] && shot G-2-conflict
    for text in "Session Already Running" "$CONFLICT_TEXT" "Force stopping will quit any running apps and processes, and could result in data loss" "Cancel" "Force Stop"; do
        showing "G-2-$try" "$text" || fail G-GREETER-CONFLICT "'$text' is not showing"
    done
    [ "$(gcount "$g" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-CONFLICT "the session started over a running one"
    gd="$(gmark)"; m="$(mark)"
    if [ "$try" = cancel ]; then
        dump G-3-cancel --press "Cancel"
        gwait "$gd" "$(call Cancel)" 10 || fail G-GREETER-CONFLICT "Cancel did not reset at GDM"
        gwait "$gd" '.kind == "logind" and .member == "SessionRemoved" and .args != ["9"]' 10 ||
            fail G-GREETER-CONFLICT "the opened session was not closed"
        twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-CONFLICT "Cancel did not return to the user list"
        sleep 1
        [ "$(gcount "$g" "$(call StartSessionWhenReady)")" = 0 ] || fail G-GREETER-CONFLICT "a cancelled login started"
    else
        dump G-3-force --press "Force Stop"
        gwait "$gd" "$(call StopConflictingSession '.outcome == "ok"')" 10 || fail G-GREETER-CONFLICT "Force Stop did not reach GDM"
        gwait "$gd" '.kind == "logind" and .member == "SessionRemoved" and .args == ["9"]' 10 ||
            fail G-GREETER-CONFLICT "the old session was not stopped"
        gwait "$gd" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 10 ||
            fail G-GREETER-CONFLICT "the session did not start once the old one stopped"
        removed="$(gline "$gd" '.kind == "logind" and .member == "SessionRemoved"')"
        started="$(gline "$gd" "$(call StartSessionWhenReady)")"
        [ "$removed" -lt "$started" ] || fail G-GREETER-CONFLICT "the session started before the old one stopped"
        twait "$m" "greeter conflict stopped session=9" 5 >/dev/null || fail G-GREETER-CONFLICT "the greeter did not see the old session go"
    fi
done
pass G-GREETER-CONFLICT "annie's remote session 9 (no re-authentication channel) conflicted: 'Session Already Running' with GNOME's remote text, Cancel and Force Stop (G-2-conflict.png); Cancel reset at GDM and closed the opened session; Force Stop sent StopConflictingSession and the session started after logind removed session 9"

# --- H: smartcard ----------------------------------------------------------
CURRENT_GATE=G-GREETER-SMARTCARD
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 6
twait "$m" "greeter page prompt user=hedy" 10 >/dev/null || fail G-GREETER-SMARTCARD "the prompt did not open for hedy"
await_password_prompt "$g" H-0-password
dump H-0-options --press "Login Options"
showing H-0-options "Smartcard" || fail G-GREETER-SMARTCARD "Login Options does not offer Smartcard"
checked H-0-options "Password" || fail G-GREETER-SMARTCARD "Password is not the selected mechanism"
gs="$(gmark)"; m="$(mark)"
dump H-0-select --press "Smartcard"
gwait "$gs" "$(call BeginVerificationForUser '.args == ["gdm-smartcard", "hedy"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SMARTCARD "choosing Smartcard did not begin gdm-smartcard"
[ -n "$(gline "$gs" "$(call Cancel)")" ] || fail G-GREETER-SMARTCARD "the password conversation was not cancelled first"
gwait "$gs" "$(sig Info '.args == ["gdm-smartcard", "Please insert smart card"]')" 10 ||
    fail G-GREETER-SMARTCARD "gdm-smartcard did not ask for the card"
sleep 1
dump H-1-insert
shot H-1-insert
showing H-1-insert "Please insert smart card" || fail G-GREETER-SMARTCARD "'Please insert smart card' is not showing"
hidden H-1-insert "Password" || fail G-GREETER-SMARTCARD "a Password entry shows for the smartcard"
gi="$(gmark)"; m="$(mark)"
control SetSmartcard true
twait "$m" "greeter smartcard inserted=true" 10 >/dev/null || fail G-GREETER-SMARTCARD "gsd-smartcard's insertion went unseen"
gwait "$gi" "$(call BeginVerificationForUser '.args == ["gdm-smartcard", "hedy"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-SMARTCARD "the insertion did not restart gdm-smartcard"
CURRENT_GATE=G-GREETER-CHOICE-LIST
gwait "$gi" "$(sig ChoiceQuery '.args[0] == "gdm-smartcard" and .args[1] == "Select a certificate"')" 10 ||
    fail G-GREETER-CHOICE-LIST "GDM's ChoiceQuery never came"
sleep 0.5
dump H-2-choice
shot H-2-choice
for text in "Select a certificate" "Hedy Lamarr (Authentication)" "Hedy Lamarr (Signing)"; do
    showing H-2-choice "$text" || fail G-GREETER-CHOICE-LIST "'$text' is not showing"
done
focused H-2-choice "Hedy Lamarr (Authentication)" || fail G-GREETER-CHOICE-LIST "the list does not have the keyboard focus"
xdotool key Down
sleep 0.2
xdotool key Return
gwait "$gi" "$(call SelectChoice '.args == ["gdm-smartcard", "cert-2"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-CHOICE-LIST "the second certificate did not reach SelectChoice"
pass G-GREETER-CHOICE-LIST "GDM's ChoiceQuery 'Select a certificate' showed as a list of its two choices (H-2-choice.png); Down, Return sent SelectChoice(gdm-smartcard, cert-2)"
CURRENT_GATE=G-GREETER-SMARTCARD
gwait "$gi" "$(sig SecretInfoQuery '.args == ["gdm-smartcard", "PIN for PIV_II: "]')" 10 ||
    fail G-GREETER-SMARTCARD "gdm-smartcard did not ask for the PIN"
sleep 0.5
dump H-3-pin
showing H-3-pin "PIN for PIV_II" || fail G-GREETER-SMARTCARD "no showing PIN entry"
[ "$(role_of H-3-pin "PIN for PIV_II")" = "password text" ] || fail G-GREETER-SMARTCARD "the PIN entry shows its text"
focused H-3-pin "PIN for PIV_II" || fail G-GREETER-SMARTCARD "the PIN entry does not have the keyboard focus"
gp="$(gmark)"
answer "$CARD_PIN"
gwait "$gp" "$(call AnswerQuery ".detail.step == \"pin\" and .detail.matches == true and .detail.answer_sha256 == \"$(sha "$CARD_PIN")\"")" 10 ||
    fail G-GREETER-SMARTCARD "the PIN did not reach AnswerQuery"
gwait "$gp" "$(call StartSessionWhenReady '.args == ["gdm-smartcard", true]')" 15 ||
    fail G-GREETER-SMARTCARD "hedy's smartcard session did not start"
control SetSmartcard false
pass G-GREETER-SMARTCARD "Login Options offered Smartcard; choosing it cancelled gdm-password and began gdm-smartcard, whose 'Please insert smart card' showed without a Password entry (H-1-insert.png); gsd-smartcard's insertion restarted it; the PIN (hidden entry) reached AnswerQuery and gdm-smartcard's session started"

# --- I: web login (SSSD's switchable authentication) -------------------------
CURRENT_GATE=G-GREETER-WEB-LOGIN
control SetSwitchable true
new_channel
m="$(mark)"; g="$(gmark)"
pick_user 7
twait "$m" "greeter page prompt user=joan" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "the prompt did not open for joan"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-switchable-auth", "joan"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-WEB-LOGIN "gdm-switchable-auth did not begin"
gwait "$g" "$(sig Request '.args[0] == "gdm-switchable-auth" and .args[1] == "auth-mechanisms"')" 10 ||
    fail G-GREETER-WEB-LOGIN "SSSD's mechanisms were not requested"
twait "$m" "greeter mechanisms list=gdm-switchable-auth:password,gdm-switchable-auth:eidp selected=gdm-switchable-auth:eidp" 10 >/dev/null ||
    fail G-GREETER-WEB-LOGIN "Login Options did not take SSSD's mechanisms with web login first"
twait "$m" "auth ask service=password step=1 kind=button" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "no Log In button"
sleep 0.5
dump I-1-button
shot I-1-button
showing I-1-button "Log In" || fail G-GREETER-WEB-LOGIN "'Log In' is not showing"
m="$(mark)"
dump I-1-press --press "Log In"
twait "$m" "auth ask service=password step=2 kind=web-login" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "the web login dialog did not open"
sleep 0.5
dump I-2-web-login
shot I-2-web-login
for text in "Log in online with another device" "https://idp.example.org/device/" "idp.example.org/device" "4219-7730" "Done" "Cancel"; do
    showing I-2-web-login "$text" || fail G-GREETER-WEB-LOGIN "'$text' is not showing"
done
hidden I-2-web-login "Password" || fail G-GREETER-WEB-LOGIN "a Password entry shows with web login"
m="$(mark)"
dump I-3-cancel --press "Cancel"
twait "$m" "auth ask service=password step=1 kind=button" 10 >/dev/null ||
    fail G-GREETER-WEB-LOGIN "the dialog's Cancel did not step back to Log In"
[ "$(gcount "$g" "$(call Reply)")" = 0 ] || fail G-GREETER-WEB-LOGIN "a reply went out before Done"
control ApproveWebLogin true
m="$(mark)"
dump I-4-again --press "Log In"
twait "$m" "auth ask service=password step=2 kind=web-login" 10 >/dev/null || fail G-GREETER-WEB-LOGIN "the dialog did not open again"
sleep 0.5
gr="$(gmark)"
dump I-5-done --press "Done"
gwait "$gr" "$(call Reply '.args[0] == "gdm-switchable-auth" and .detail.mechanism == "eidp" and .detail.status == "Ok" and .detail.matches == true')" 10 ||
    fail G-GREETER-WEB-LOGIN "Done did not reply {\"eidp\": {}} to SSSD"
gwait "$gr" "$(call StartSessionWhenReady '.args == ["gdm-switchable-auth", true]')" 15 ||
    fail G-GREETER-WEB-LOGIN "joan's web login did not start her session"
control SetSwitchable false
control ApproveWebLogin false
pass G-GREETER-WEB-LOGIN "SSSD's CustomJSON auth-mechanisms put web login first: 'Log In', then the dialog with GNOME's message, the QR code of https://idp.example.org/device/, the URL as idp.example.org/device and code 4219-7730 (I-2-web-login.png); Cancel stepped back to 'Log In'; Done replied authSelection {status Ok, eidp {}} and gdm-switchable-auth's session started"

# --- J: authentication policy ---------------------------------------------
CURRENT_GATE=G-GREETER-POLICY-AUTH
new_channel
gsettings set org.gnome.login-screen enable-password-authentication false
sleep 1
m="$(mark)"; g="$(gmark)"
pick_user 6
twait "$m" "greeter page prompt user=hedy" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "the prompt did not open for hedy"
gwait "$g" "$(call BeginVerificationForUser '.args == ["gdm-smartcard", "hedy"] and .outcome == "ok"')" 15 ||
    fail G-GREETER-POLICY-AUTH "gdm-smartcard did not begin with passwords disabled"
gwait "$g" "$(sig Info '.args == ["gdm-smartcard", "Please insert smart card"]')" 10 ||
    fail G-GREETER-POLICY-AUTH "gdm-smartcard did not ask for the card"
sleep 1
dump J-1-policy
shot J-1-policy
hidden J-1-policy "Password" || fail G-GREETER-POLICY-AUTH "a Password entry or mechanism shows with passwords disabled"
showing J-1-policy "Please insert smart card" || fail G-GREETER-POLICY-AUTH "the smartcard prompt is not showing"
[ "$(gcount "$g" "$(call BeginVerificationForUser '.args[0] == "gdm-password"')")" = 0 ] ||
    fail G-GREETER-POLICY-AUTH "gdm-password began with passwords disabled"
dump J-2-options --press "Login Options"
showing J-2-options "Smartcard" || fail G-GREETER-POLICY-AUTH "Login Options does not offer Smartcard"
hidden J-2-options "Password" || fail G-GREETER-POLICY-AUTH "Login Options offers Password"
dump J-3-closed --press "Login Options"
gsettings set org.gnome.login-screen enable-switchable-authentication false
sleep 1
m="$(mark)"; g="$(gmark)"
xdotool key Escape
gwait "$g" "$(call BeginVerification '.args == ["gdm-smartcard"] and .outcome == "ok"')" 10 ||
    fail G-GREETER-POLICY-AUTH "smartcard alone did not begin without a username"
twait "$m" "greeter page prompt user=" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "the prompt did not open without a user"
sleep 0.5
dump J-4-no-user
shot J-4-no-user
hidden J-4-no-user "Not listed?" || fail G-GREETER-POLICY-AUTH "the user list shows"
hidden J-4-no-user "Hedy Lamarr" || fail G-GREETER-POLICY-AUTH "the prompt still names hedy"
gsettings reset org.gnome.login-screen enable-password-authentication
gsettings reset org.gnome.login-screen enable-switchable-authentication
sleep 1
m="$(mark)"
xdotool key Escape
twait "$m" "greeter page users" 10 >/dev/null || fail G-GREETER-POLICY-AUTH "with passwords back the user list did not return"
pass G-GREETER-POLICY-AUTH "with enable-password-authentication false Login Options offered Smartcard only, no Password entry showed and gdm-smartcard began for hedy (J-1-policy.png); with enable-switchable-authentication false as well no username was asked: BeginVerification(gdm-smartcard) (J-4-no-user.png)"

# --- K: timed login ---------------------------------------------------------
CURRENT_GATE=G-GREETER-TIMED-LOGIN
control SetTimedLogin "'katherine'" 8
m="$(mark)"; g="$(gmark)"
new_channel
gwait "$g" "$(call GetTimedLoginDetails '.outcome == "ok"')" 10 || fail G-GREETER-TIMED-LOGIN "the greeter did not ask for the timed login details"
twait "$m" "greeter timed-login requested user=katherine delay=8" 10 >/dev/null ||
    fail G-GREETER-TIMED-LOGIN "TimedLoginRequested was not taken"
twait "$m" "greeter timed-login indicator user=katherine secs=3" 15 >/dev/null ||
    fail G-GREETER-TIMED-LOGIN "the countdown did not start after 5 idle seconds"
sleep 1
dump K-1-timed
shot K-1-timed
showing K-1-timed "Automatic login" || fail G-GREETER-TIMED-LOGIN "the countdown is not showing"
[ "$(gcount "$g" "$(call BeginAutoLogin)")" = 0 ] || fail G-GREETER-TIMED-LOGIN "auto login began early"
m="$(mark)"
pressed="$(date +%s.%N)"
xdotool key Shift_L
twait "$m" "greeter timed-login restart" 5 >/dev/null || fail G-GREETER-TIMED-LOGIN "a key did not start the countdown over"
sleep 0.5
dump K-2-restarted
hidden K-2-restarted "Automatic login" || fail G-GREETER-TIMED-LOGIN "the countdown kept running after a key"
gwait "$g" "$(call BeginAutoLogin '.args == ["katherine"] and .outcome == "ok"')" 20 ||
    fail G-GREETER-TIMED-LOGIN "BeginAutoLogin(katherine) never came"
began="$(wall_of "$g" "$(call BeginAutoLogin)")"
waited="$("$PY" -c "print(round($began - $pressed, 2))")"
"$PY" -c "import sys; sys.exit(0 if $waited >= 7.5 else 1)" ||
    fail G-GREETER-TIMED-LOGIN "auto login began ${waited}s after the key, not after the full 8 s"
gwait "$g" "$(call StartSessionWhenReady '.args == ["gdm-autologin", true]')" 15 ||
    fail G-GREETER-TIMED-LOGIN "gdm-autologin's session did not start"
control SetTimedLogin "''" 0
pass G-GREETER-TIMED-LOGIN "GetTimedLoginDetails answered TimedLoginRequested(katherine, 8); after 5 idle seconds Katherine's row counted down 3 s (K-1-timed.png); a key hid it and started over; BeginAutoLogin(katherine) came ${waited}s after the key and gdm-autologin's session started"

# --- E: supervision, and a login with GDM's default session -------------
CURRENT_GATE=G-GREETER-SUPERVISION
first="$GREETER_PID"
g="$(gmark)"; m="$(mark)"
kill -KILL "$first"
await_greeter "$first" 30 || fail G-GREETER-SUPERVISION "the compositor did not restart a killed greeter"
gwait "$g" '.kind == "disconnect"' 10 || fail G-GREETER-SUPERVISION "the killed greeter's channel did not close"
gwait "$g" "$(call OpenSession)" 20 || fail G-GREETER-SUPERVISION "the restarted greeter did not ask GDM for its channel"
twait "$m" "greeter page users" 30 >/dev/null || fail G-GREETER-SUPERVISION "the restarted greeter did not show the user list"
cstate '.layers | any(.namespace == "tuna-greeter")' 20 || fail G-GREETER-SUPERVISION "the restarted greeter's layer did not map"
sleep 1
dump E-1-restarted
shot E-1-restarted
showing E-1-restarted "Grace Hopper" || fail G-GREETER-SUPERVISION "the restarted greeter's user list is not showing"
[ "$(grep -c ' READY=1$' "$NOTIFY_LOG")" = 1 ] || fail G-GREETER-READY "READY=1 was sent again for a restarted greeter"
restarted="$GREETER_PID"

CURRENT_GATE=G-GREETER-SESSION
m="$(mark)"; g="$(gmark)"
pick_user 1
twait "$m" "greeter page prompt user=grace" 10 >/dev/null || fail G-GREETER-SESSION "the prompt did not open for grace"
await_password_prompt "$g" E-2-prompt
type_password E-2-prompt "$GRACE_PASSWORD"
gwait "$g" "$(call StartSessionWhenReady '.args == ["gdm-password", true]')" 15 ||
    fail G-GREETER-SESSION "grace's login did not start"
[ "$(gcount "$g" "$(call SelectSession)")" = 0 ] || fail G-GREETER-SESSION "SelectSession was sent without a choice"
selected="$(gsel "$g" "$(call StartSessionWhenReady)" | jq -r '.detail.selected_session')"
[ "$selected" = tuna ] || fail G-GREETER-SESSION "the default login would start $selected, not tuna"
pass G-GREETER-SESSION "Login Options showed GDM's default Tuna checked; GNOME (keys: $how) reached SelectSession, the focus went back to the Password entry, GNOME was re-selected after the retry's begin and was the session started; a login without a choice sent no SelectSession and started tuna"

CURRENT_GATE=G-GREETER-SUPERVISION
kills=1
previous="$restarted"
while alive; do
    kill -KILL "$previous" 2>/dev/null || true
    kills=$((kills + 1))
    [ "$kills" -le 10 ] || fail G-GREETER-SUPERVISION "the compositor outlived $kills greeter kills"
    if ! await_greeter "$previous" 20; then
        break
    fi
    previous="$GREETER_PID"
done
for _ in $(seq 1 100); do alive || break; sleep 0.1; done
alive && fail G-GREETER-SUPERVISION "the compositor is still running after the greeter's budget ran out"
if wait "$COMPOSITOR_PID"; then COMPOSITOR_STATUS=0; else COMPOSITOR_STATUS=$?; fi
COMPOSITOR_PID=""
[ "$COMPOSITOR_STATUS" != 0 ] || fail G-GREETER-SUPERVISION "the compositor exited 0 with the greeter's budget spent"
grep -qF "tuna-compositor: greeter restart budget exhausted; ending the login screen" "$LOG" ||
    fail G-GREETER-SUPERVISION "the compositor did not say the greeter's budget ran out"
pass G-GREETER-SUPERVISION "a killed greeter came back as pid $restarted (was $first) with a new GDM channel and the user list; after $kills kills the budget ran out and the compositor exited $COMPOSITOR_STATUS"

# --- Z: hygiene ---------------------------------------------------------
CURRENT_GATE=G-GREETER-HYGIENE
if grep -rlF -e "$ADA_PASSWORD" -e "$GRACE_PASSWORD" -e "$KATHERINE_PASSWORD" -e "$WRONG_PASSWORD" \
    -e "$DOROTHY_PASSWORD" -e "$DOROTHY_CODE" -e "$MARY_PASSWORD" -e "$ANNIE_PASSWORD" \
    -e "$HEDY_PASSWORD" -e "$JOAN_PASSWORD" -e "$CARD_PIN" \
    "$ARTIFACTS" >"$ARTIFACTS/secret-hits.txt" 2>/dev/null; then
    fail G-GREETER-HYGIENE "a secret reached the artifacts: $(tr '\n' ' ' <"$ARTIFACTS/secret-hits.txt")"
fi
grep -qi panicked "$LOG" && fail G-GREETER-HYGIENE "panic in the nested log"
pass G-GREETER-HYGIENE "no password, verification code or PIN in any artifact or log; no panic"
